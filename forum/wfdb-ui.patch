diff --git a/apps/web/src/themes/light/pages/WfdbAuthPage.tsx b/apps/web/src/themes/light/pages/WfdbAuthPage.tsx
new file mode 100644
index 0000000..9561214
--- /dev/null
+++ b/apps/web/src/themes/light/pages/WfdbAuthPage.tsx
@@ -0,0 +1,28 @@
+import { Link, useNavigate } from 'react-router';
+import { AuthAnnouncement, LoginForm, RegisterForm } from '../../../components/AuthForms';
+import { SiteLogo } from '../../../components/SiteLogo';
+import { useGuestOnly } from '../../../hooks/useGuestOnly';
+import { useLang, useLocalizedSetting, useT } from '../../../lib/i18n';
+
+export function WfdbAuthPage({ register = false }: { register?: boolean }) {
+  const t = useT();
+  const chinese = useLang().startsWith('zh');
+  const navigate = useNavigate();
+  const setting = useLocalizedSetting();
+  useGuestOnly();
+
+  const Form = register ? RegisterForm : LoginForm;
+  return (
+    <section className="wfdb-auth zh-card" aria-labelledby="wfdb-auth-title">
+      <Link to="/" className="inline-flex" aria-label={chinese ? '返回论坛' : 'Back to forum'}><SiteLogo /></Link>
+      <h1 id="wfdb-auth-title">{register ? t('register_new_account') : t('user_login')}</h1>
+      <p>{chinese ? '论坛与 WFDB 客户端共用这个账号。' : 'Use the same account on the forum and in the WFDB desktop app.'}</p>
+      <AuthAnnouncement />
+      <Form onSuccess={() => navigate('/')} />
+      <div className="wfdb-auth-links">
+        <Link to={register ? '/login' : '/register'}>{register ? t('direct_login') : t('register_new_account')}</Link>
+        {setting?.userResetpwOn && <Link to="/resetpw">{t('forgot_pw')}</Link>}
+      </div>
+    </section>
+  );
+}
